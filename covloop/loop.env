# Small self-hosted round: loop2 v0.2 (on main) runs this against itself.
# Scope is narrow and fully covered by objective tests, so no reviewer turn
# — go test is the whole check. Kept small on purpose: this is the first
# time loop2 runs unsupervised against real pi, so the blast radius (one
# failing test, one file) is intentionally tiny.

LOOP_MAX_ITER=4
LOOP_SESSION=none
LOOP_BRANCH=1
LOOP_BRANCH_BASE=main
LOOP_TEST_CMD=go test ./...
LOOP_WRITER_MODEL=synthetic/hf:zai-org/GLM-5.2

LOOP_FREEZE='*_test.go fake-pi *.jsonl loop.env manifest tests.sh'
