# double-check — the weakest gate (pattern #1 from the research)
# Two turns share one session: the second is a hostile self-review of the first.
# No objective gate, so the loop just runs both turns and stops (exits 0).
# Treat its "looks good" with suspicion; upgrade to until-green when you can.

LOOP_MAX_ITER=1            # one pass through the manifest = writer + critic = 2 turns
LOOP_SESSION=shared
LOOP_BRANCH=0

# Optional: pin models. Empty = use pi's default.
# LOOP_WRITER_MODEL=xai/grok-4.5
