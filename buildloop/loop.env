# Dogfood: the POSIX loop in ../loop runs this to implement loop2.
# Session is none so each turn re-reads DESIGN.md instead of accumulating
# a session that will compact. The tests are the hard gate.

LOOP_MAX_ITER=8
LOOP_SESSION=none
LOOP_BRANCH=1
LOOP_BRANCH_BASE=main
LOOP_TEST_CMD=go test ./...
LOOP_WRITER_MODEL=xai/grok-4.5

# Anti-cheat: the suite is the spec. Do not let the writer edit it.
LOOP_FREEZE='*_test.go fake-pi *.jsonl'
