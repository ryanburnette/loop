# v0.3 dogfood: GLM-5.2 writes, Claude Opus 5 reviews against
# CHECKLIST-v0.3.md, GLM-5.2 fixes. This round is a bigger reframe (cwd +
# .loop/ resolution, loop init, a UI overhaul, a pi skill) than v0.2's bugfix
# set, so it gets more headroom, but the pattern is identical: cheap
# deterministic gates first, then the required cross-model checklist
# review, bounded by the iteration cap.
#
# Session is none so each turn re-reads the spec files instead of relying on
# conversation memory; continuity across iterations comes from git history,
# gate-log.md, and handoff.md.

LOOP_MAX_ITER=6
LOOP_SESSION=none
LOOP_BRANCH=1
LOOP_BRANCH_BASE=main
LOOP_TEST_CMD=go test ./...
LOOP_WRITER_MODEL=synthetic/hf:zai-org/GLM-5.2
LOOP_REVIEWER_MODEL=anthropic/claude-opus-5

# Anti-cheat. Freeze the tests, the fixtures, and the meta-files that define
# what "done" means so the loop cannot pass by editing its own goal or gate.
LOOP_FREEZE='*_test.go fake-pi *.jsonl loop.env manifest tests.sh CHECKLIST.md CHECKLIST-v0.3.md DESIGN.md DESIGN-v0.2.md DESIGN-v0.3.md CONSTRAINTS.md writer.md reviewer.md fixer.md'
