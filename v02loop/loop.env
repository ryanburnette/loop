# v0.2 dogfood: GLM-5.2 writes, Claude Opus 5 reviews, tests are the hard gate.
# Session is none so each turn re-reads DESIGN-v0.2.md. Shared would compact.

LOOP_MAX_ITER=8
LOOP_SESSION=none
LOOP_BRANCH=1
LOOP_BRANCH_BASE=main
LOOP_TEST_CMD=go test ./...
LOOP_WRITER_MODEL=synthetic/hf:zai-org/GLM-5.2
LOOP_REVIEWER_MODEL=anthropic/claude-opus-5

# Anti-cheat: the suite is the spec. Do not let the writer edit it.
LOOP_FREEZE='*_test.go fake-pi *.jsonl'
