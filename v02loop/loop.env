# v0.2 dogfood: GLM-5.2 writes, Claude Opus 5 reviews against CHECKLIST.md,
# GLM-5.2 fixes. Tests+frozen are the hard gate (guardrail: cheapest/most
# objective check first). The reviewer verdict is required too — it is the
# stand-in for everything go test cannot grade (usability, docs, errors).
# Soft-but-structured check + hard iteration cap, per the guardrails.
#
# Session is none so each turn re-reads the spec files instead of relying on
# conversation memory; continuity across iterations comes from git history,
# gate-log.md, and handoff.md, not from a session that would eventually need
# compaction.

LOOP_MAX_ITER=10
LOOP_SESSION=none
LOOP_BRANCH=1
LOOP_BRANCH_BASE=main
LOOP_TEST_CMD=go test ./...
LOOP_WRITER_MODEL=synthetic/hf:zai-org/GLM-5.2
LOOP_REVIEWER_MODEL=anthropic/claude-opus-5

# Anti-cheat. Freeze the tests, the fixtures, and the meta-files that define
# what "done" means (checklist, specs, manifest, loop.env, gate scripts) so
# the loop cannot pass by editing its own goal or its own gate.
LOOP_FREEZE='*_test.go fake-pi *.jsonl loop.env manifest tests.sh CHECKLIST.md DESIGN.md DESIGN-v0.2.md CONSTRAINTS.md writer.md reviewer.md fixer.md'
